{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "idempotency_key",
    "operation_id",
    "actor_id",
    "source_revision",
    "ingestion_generation",
    "media_operation_id",
    "media_generation",
    "chapter_id",
    "expected_revision",
    "chapter_number",
    "title",
    "manifest",
    "payload_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "idempotency_key": {
      "$ref": "types.schema.json#/$defs/uuid"
    },
    "operation_id": {
      "$ref": "types.schema.json#/$defs/uuid"
    },
    "actor_id": {
      "$ref": "types.schema.json#/$defs/uuid"
    },
    "source_revision": {
      "$ref": "types.schema.json#/$defs/positive"
    },
    "ingestion_generation": {
      "$ref": "types.schema.json#/$defs/positive"
    },
    "media_operation_id": {
      "$ref": "types.schema.json#/$defs/uuid"
    },
    "media_generation": {
      "$ref": "types.schema.json#/$defs/positive"
    },
    "chapter_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "types.schema.json#/$defs/uuid"
        }
      ]
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740990
    },
    "chapter_number": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,5})\\.[0-9]{2}$"
    },
    "title": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 255,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "manifest": {
      "$ref": "types.schema.json#/$defs/manifest"
    },
    "payload_sha256": {
      "$ref": "types.schema.json#/$defs/sha256"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalog chapter publication command v1",
  "allOf": [
    {
      "if": {
        "properties": {
          "chapter_id": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "expected_revision": {
            "const": 0
          }
        }
      },
      "else": {
        "properties": {
          "expected_revision": {
            "minimum": 1
          }
        }
      }
    }
  ]
}
