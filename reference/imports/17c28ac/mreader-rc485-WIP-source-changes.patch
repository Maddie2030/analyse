+            FROM chapter_reads WHERE user_id=%s AND chapter_id=%s
+        """, (user.user_id, chapter))
+        first, last, provenance, completed = cur.fetchone()
+    actual_open = datetime.fromisoformat(accepted["last_opened_at"].replace("Z", "+00:00"))
