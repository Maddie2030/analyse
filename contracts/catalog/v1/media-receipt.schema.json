{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "media_operation_id",
    "operation_id",
    "actor_id",
    "source_revision",
    "media_generation",
    "page_count",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "status": {
      "const": "completed"
    },
    "media_operation_id": {
      "$ref": "types.schema.json#/$defs/uuid"
    },
    "operation_id": {
      "$ref": "types.schema.json#/$defs/uuid"
    },
    "actor_id": {
      "$ref": "types.schema.json#/$defs/uuid"
    },
    "source_revision": {
      "$ref": "types.schema.json#/$defs/positive"
    },
    "media_generation": {
      "$ref": "types.schema.json#/$defs/positive"
    },
    "page_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "manifest_sha256": {
      "$ref": "types.schema.json#/$defs/sha256"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Durable Media completion evidence v1"
}
