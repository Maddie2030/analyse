{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mreader.local/contracts/ownership/postgres-roles.v1.schema.json",
  "title": "MReader PostgreSQL runtime role contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "authorities", "capabilities", "workloads", "worker_exceptions", "acceptance_test_ids"],
  "properties": {
    "contract": {"const": "mreader.postgres-roles"},
    "version": {"const": 1},
    "authorities": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "capabilities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capability"}},
    "workloads": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/workload"}},
    "worker_exceptions": {"type": "array", "items": {"$ref": "#/$defs/worker_exception"}},
    "acceptance_test_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2}$"}}
  },
  "$defs": {
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_type", "resource", "privileges", "columns"],
      "properties": {
        "object_type": {"enum": ["database", "schema", "table", "view", "sequence", "function"]},
        "resource": {"type": "string", "minLength": 1},
        "privileges": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["connect", "usage", "select", "insert", "update", "delete", "execute"]}},
        "columns": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "login", "role_attributes", "grants", "acceptance_test_ids"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "login": {"const": "NOLOGIN"},
        "role_attributes": {"type": "array", "maxItems": 0},
        "grants": {"type": "array", "items": {"$ref": "#/$defs/grant"}},
        "acceptance_test_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workload", "role", "login", "role_attributes", "capabilities", "dsn_env", "scope_file", "acceptance_test_ids"],
      "properties": {
        "workload": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
        "role": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "login": {"const": "LOGIN"},
        "role_attributes": {"type": "array", "maxItems": 0},
        "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}},
        "dsn_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
        "scope_file": {"type": "string", "minLength": 1},
        "acceptance_test_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "worker_exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workload", "resource", "privileges", "evidence", "reason"],
      "properties": {
        "workload": {"type": "string", "minLength": 1},
        "resource": {"type": "string", "minLength": 1},
        "privileges": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["select", "insert", "update", "delete", "usage", "execute"]}},
        "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
