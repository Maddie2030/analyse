# ============================================================
# .env.prod.example — Production environment template
# ============================================================
# Copy to .env.prod and fill in real values before deploying.
#   cp .env.prod.example .env.prod
#
# NEVER commit .env.prod to git.
# ============================================================

# ── Domain (for Caddy TLS) ─────────────────────────────
# Set to your real domain for automatic HTTPS, or :80 for local testing
DOMAIN=:80

# ── Database ──────────────────────────────────────────
POSTGRES_USER=manhwa
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=manhwa
DATABASE_URL=postgresql+asyncpg://manhwa:CHANGE_ME_TO_A_STRONG_PASSWORD@db:5432/manhwa
DB_POOL_SIZE=4
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=10000

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=40
REDIS_DATA_MAXMEMORY=384mb
REDIS_MAXMEMORY_POLICY=volatile-lru
REDIS_APPENDONLY=yes
REDIS_APPENDFSYNC=everysec

# ── SeaweedFS ──────────────────────────────────────────
SEAWEEDFS_MASTER_URL=http://seaweedfs-master:9333
SEAWEEDFS_FILER_URL=http://seaweedfs-filer:8888
SEAWEEDFS_REPLICATION=001
SEAWEEDFS_HTTP_MAX_CONNECTIONS=16
SEAWEEDFS_HTTP_KEEPALIVE_CONNECTIONS=8
SEAWEEDFS_WRITE_CONCURRENCY=2
SEAWEEDFS_SLOW_WRITE_THRESHOLD_SECONDS=1.5
SEAWEEDFS_SLOW_WRITE_COOLDOWN_SECONDS=0.25
SEAWEEDFS_MAX_RETRIES=8
SEAWEEDFS_RETRY_BASE_SECONDS=1.0
SEAWEEDFS_RETRY_MAX_DELAY_SECONDS=15.0

# ── Auth / Sessions ────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
TOKEN_SECRET=CHANGE_ME_GENERATE_A_64_CHAR_RANDOM_STRING
SESSION_TTL_SECONDS=86400
SESSION_COOKIE_NAME=session_id
# Set to true when using HTTPS (production with a domain)
COOKIE_SECURE=false

# ── Image Tokens ───────────────────────────────────────
IMAGE_TOKEN_TTL_SECONDS=300
# Keep false for same-origin/local delivery. Gcore/hybrid Compose modes override true.
IMAGE_GRANT_ALLOW_SESSIONLESS_DELIVERY=false
PAGE_MAX_WIDTH=1080
PAGE_RESPONSIVE_WIDTH=720
PAGE_ENCODING_V4_ROWS=4
PAGE_ENCODING_V4_COLUMNS=4
PAGE_ENCODING_V4_OVERLAP=12

# ── Rate Limiting ──────────────────────────────────────
RATE_LIMIT_REQUESTS=200
RATE_LIMIT_WINDOW_SECONDS=60

# ── Turnstile (optional) ───────────────────────────────
TURNSTILE_SECRET=
TURNSTILE_ENABLED=false

# ── CORS / Frontend ─────────────────────────────────────
# Set to your actual domain(s) in production
ALLOWED_ORIGIN=https://your-domain.com
DEBUG=false

# ── Upload ──────────────────────────────────────────────
STORAGE_PATH=/data/manga_storage
MAX_UPLOAD_SIZE_MB=500
PAGE_MAX_SEGMENT_HEIGHT=8192
PAGE_WEBP_QUALITY=85
MAX_UNCOMPRESSED_PAGE_SIZE_MB=100
MAX_THUMBNAIL_SIZE_MB=10

SEAWEEDFS_IMAGE_TAG=4.41

# Social TS notification retention
# Read alerts expire 14 days after delivery; unread alerts expire after 30 days.
NOTIFICATION_RETENTION_READ_DAYS=14
NOTIFICATION_RETENTION_UNREAD_DAYS=30
NOTIFICATION_RETENTION_SWEEP_HOURS=24
NOTIFICATION_RETENTION_BATCH_SIZE=5000
NOTIFICATION_RETENTION_MAX_BATCHES=20

# ── RabbitMQ / durable operational jobs + event dispatch ──
# Production target: external/managed RabbitMQ over private networking/TLS.
RABBITMQ_USER=mreader
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_VHOST=mreader
RABBITMQ_URL=amqps://mreader:CHANGE_ME@rabbitmq.internal:5671/mreader
KEDA_RABBITMQ_HTTP_URL=
KEDA_POSTGRES_URL=
RABBITMQ_JOBS_EXCHANGE=mreader.jobs
RABBITMQ_EVENTS_EXCHANGE=mreader.events
RABBITMQ_EVENTS_ARCHIVE_QUEUE=mreader.events.archive
RABBITMQ_RETRY_DELAY_MS=5000
RABBITMQ_MAX_ATTEMPTS=3

# Notification worker: durable at-least-once chapter/user notification delivery.
NOTIFICATION_WORKER_QUEUE=mreader.notification.worker
NOTIFICATION_RETRY_EXCHANGE=mreader.notification.retry
NOTIFICATION_RETRY_QUEUE=mreader.notification.worker.retry
NOTIFICATION_DEAD_EXCHANGE=mreader.notification.dead
NOTIFICATION_DEAD_QUEUE=mreader.notification.worker.dlq
NOTIFICATION_RETRY_DELAY_MS=5000
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_PREFETCH=8
NOTIFICATION_DB_MAX_CONNS=8

# Realtime Go: one same-origin WebSocket for alerts and discussion signals.
REALTIME_DB_MAX_CONNS=6
REALTIME_RECONNECT_DELAY_MS=2000
REALTIME_WRITE_TIMEOUT_SECONDS=10
REALTIME_PONG_WAIT_SECONDS=60
REALTIME_PING_PERIOD_SECONDS=25
REALTIME_SESSION_RECHECK_SECONDS=60
REALTIME_MAX_MESSAGE_BYTES=16384

# ── Backend resource efficiency ─────────────────────
# Defaults target a modest single-host deployment. Raise deliberately after
# observing CPU, RAM and PostgreSQL saturation; do not increase everything at once.
AUTH_API_WORKERS=1
IMAGE_API_WORKERS=1
SCRAPER_API_WORKERS=1
CATALOG_PY_API_WORKERS=1
READER_PY_API_WORKERS=1
SOCIAL_PY_API_WORKERS=1
MEDIA_WORKER_MAX_JOBS=2
MEDIA_RECOVERY_INTERVAL_SECONDS=30
MEDIA_PROCESSING_LEASE_SECONDS=120
MEDIA_HEARTBEAT_INTERVAL_SECONDS=30
VIPS_CONCURRENCY=1
VIPS_CACHE_MAX_OPS=100
VIPS_CACHE_MAX_MEM_MB=128
VIPS_CACHE_MAX_FILES=50
CATALOG_GO_DB_MAX_CONNS=10
READER_GO_DB_MAX_CONNS=14
PROGRESS_GO_DB_MAX_CONNS=6
SOCIAL_DB_CONNECTION_LIMIT=8
SOCIAL_DB_POOL_TIMEOUT=10
SCRAPER_REDIS_MAX_CONNECTIONS=32
SCRAPER_API_DB_MAX_CONNECTIONS=5
SCRAPER_API_HTTP_MAX_CONNECTIONS=32
SCRAPER_API_HTTP_KEEPALIVE_CONNECTIONS=12
SCRAPER_BATCH_DB_MAX_CONNECTIONS=3
SCRAPER_BATCH_HTTP_MAX_CONNECTIONS=16
SCRAPER_BATCH_HTTP_KEEPALIVE_CONNECTIONS=8
SCRAPER_SERIES_DB_MAX_CONNECTIONS=8
SCRAPER_SERIES_HTTP_MAX_CONNECTIONS=32
SCRAPER_SERIES_HTTP_KEEPALIVE_CONNECTIONS=16

# ── Docker resource guardrails (upper bounds, not reservations) ─────
# Defaults protect a single host from runaway workers. Raise individual limits
# only after observing real pressure in Grafana/cAdvisor.
# Resource profile: v1.1.5c RC2 balanced = 50% of the temporary 2x profile.
MREADER_RESOURCE_PROFILE=v115c-rc2-balanced
DB_MEMORY_LIMIT=1g
DB_CPU_LIMIT=1.5
REDIS_MEMORY_LIMIT=640m
REDIS_CPU_LIMIT=0.75
# Hybrid profile only: same aggregate 640 MiB / 0.75 CPU, split by criticality.
REDIS_CRITICAL_MEMORY_LIMIT=384m
REDIS_CRITICAL_CPU_LIMIT=0.45
REDIS_CRITICAL_DATA_MAXMEMORY=224mb
REDIS_CACHE_MEMORY_LIMIT=256m
REDIS_CACHE_CPU_LIMIT=0.30
REDIS_CACHE_DATA_MAXMEMORY=160mb
SEAWEED_MASTER_MEMORY_LIMIT=256m
SEAWEED_MASTER_CPU_LIMIT=0.5
SEAWEED_VOLUME_MEMORY_LIMIT=1g
SEAWEED_VOLUME_CPU_LIMIT=1.0
SEAWEED_FILER_MEMORY_LIMIT=512m
SEAWEED_FILER_CPU_LIMIT=0.75
AUTH_MEMORY_LIMIT=384m
AUTH_CPU_LIMIT=0.5
CATALOG_MEMORY_LIMIT=256m
CATALOG_CPU_LIMIT=0.75
READER_MEMORY_LIMIT=384m
READER_CPU_LIMIT=1.0
PROGRESS_MEMORY_LIMIT=256m
PROGRESS_CPU_LIMIT=0.5
SOCIAL_MEMORY_LIMIT=512m
SOCIAL_CPU_LIMIT=1.0
SOCIAL_NODE_MAX_OLD_SPACE_MB=320
SCRAPER_API_MEMORY_LIMIT=512m
SCRAPER_API_CPU_LIMIT=1.0
SCRAPER_BATCH_MEMORY_LIMIT=768m
SCRAPER_BATCH_CPU_LIMIT=1.0
SCRAPER_SERIES_MEMORY_LIMIT=1g
SCRAPER_SERIES_CPU_LIMIT=1.5
IMAGE_API_MEMORY_LIMIT=640m
IMAGE_API_CPU_LIMIT=1.0
MEDIA_WORKER_MEMORY_LIMIT=2g
MEDIA_WORKER_CPU_LIMIT=2.0
LIFECYCLE_MEMORY_LIMIT=384m
LIFECYCLE_CPU_LIMIT=0.5
IMAGE_EDGE_MEMORY_LIMIT=256m
IMAGE_EDGE_CPU_LIMIT=0.5
FRONTEND_MEMORY_LIMIT=192m
FRONTEND_CPU_LIMIT=0.25
GATEWAY_MEMORY_LIMIT=256m
GATEWAY_CPU_LIMIT=0.5
RABBITMQ_MEMORY_LIMIT=512m
RABBITMQ_CPU_LIMIT=0.75
NOTIFICATION_WORKER_MEMORY_LIMIT=256m
NOTIFICATION_WORKER_CPU_LIMIT=0.5
REALTIME_MEMORY_LIMIT=256m
REALTIME_CPU_LIMIT=0.5
MEDIA_THUMBNAIL_WORKER_MEMORY_LIMIT=512m
MEDIA_THUMBNAIL_WORKER_CPU_LIMIT=1.0
MEDIA_THUMBNAIL_WORKER_MAX_JOBS=2
PROMETHEUS_MEMORY_LIMIT=768m
PROMETHEUS_CPU_LIMIT=1.0
GRAFANA_MEMORY_LIMIT=512m
GRAFANA_CPU_LIMIT=0.75
LOKI_MEMORY_LIMIT=512m
LOKI_CPU_LIMIT=0.75
ALLOY_MEMORY_LIMIT=384m
ALLOY_CPU_LIMIT=0.5
CADVISOR_MEMORY_LIMIT=256m
CADVISOR_CPU_LIMIT=0.5
BLACKBOX_MEMORY_LIMIT=128m
BLACKBOX_CPU_LIMIT=0.25
UPTIME_KUMA_MEMORY_LIMIT=384m
UPTIME_KUMA_CPU_LIMIT=0.5
CROWDSEC_MEMORY_LIMIT=384m
CROWDSEC_CPU_LIMIT=0.5
CLOUDFLARED_MEMORY_LIMIT=256m
CLOUDFLARED_CPU_LIMIT=0.5
NGROK_MEMORY_LIMIT=192m
NGROK_CPU_LIMIT=0.25
MIGRATE_MEMORY_LIMIT=256m
MIGRATE_CPU_LIMIT=0.5

# ── Durable workers / lifecycle ────────────────────
SCRAPER_SERIES_WORKER_CONCURRENCY=4
LIFECYCLE_CLEANUP_POLL_SECONDS=2
LIFECYCLE_HEARTBEAT_SECONDS=30
LIFECYCLE_PROCESSING_STALE_SECONDS=300
LIFECYCLE_RECOVERY_INTERVAL_SECONDS=60

# ── Reader runtime / CDN ───────────────────────────
# Empty = same-origin /images through the local authenticated image-edge cache.
# Set to a Gcore/other CDN hostname only when that CDN fronts the scrambled /images assets.
IMAGE_CDN_URL=
READER_FETCH_BEHIND=1
READER_FETCH_AHEAD=2
READER_RETAIN_BEHIND=2
READER_RETAIN_AHEAD=4

# Optional external edge/tunnel modes
# :80 for local/Cloudflare Tunnel. For any public .dev domain, set the real hostname
# here (for example mreader.example.dev) so Caddy serves HTTPS; browsers require HTTPS for .dev.
CADDY_SITE_ADDRESS=:80
# Host-only gateway used by Tailscale Funnel. The public helper keeps this bound to loopback.
LOCAL_GATEWAY_PORT=8080
# Filled automatically by scripts/tailscale/start-public.* after Tailscale is connected.
TAILSCALE_PUBLIC_URL=
TAILSCALE_FUNNEL_HTTPS_PORT=443
CLOUDFLARE_TUNNEL_TOKEN=
# Optional lifecycle cache purge credentials. Leave blank to disable provider API purges.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
GCORE_CDN_URL=
GCORE_CDN_RESOURCE_ID=
GCORE_API_TOKEN=
GCORE_ORIGIN_PORT=8088
NGROK_AUTHTOKEN=
NGROK_DOMAIN=


# ── v1.1.4 reader analytics / progress recovery ─────
# Trending is non-critical: failures must never fail a Reader request.
READER_TRENDING_ENABLED=true
READER_TRENDING_DEDUPE_TTL_SECONDS=1800
READER_TRENDING_QUEUE_SIZE=4096
READER_TRENDING_WORKERS=2
READER_TRENDING_RETENTION_DAYS=45

# Recover Progress stream messages abandoned by a crashed worker.
PROGRESS_GO_RECLAIM_MIN_IDLE_SECONDS=30
PROGRESS_GO_RECLAIM_INTERVAL_SECONDS=10

# ── Transactional outbox relay ──────────────────────
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_CLAIM_STALE_SECONDS=120
OUTBOX_PUBLISH_TIMEOUT_SECONDS=10
OUTBOX_RETRY_BASE_SECONDS=1
OUTBOX_RETRY_MAX_SECONDS=300
OUTBOX_DB_MAX_CONNS=10
OUTBOX_RELAY_MEMORY_LIMIT=256m
OUTBOX_RELAY_CPU_LIMIT=0.5

# ── Observability ──────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-in-production
GCORE_ORIGIN_BIND=0.0.0.0

# Durable scraper cancellation/recovery convergence
SCRAPER_RECOVERY_INTERVAL_SECONDS=15

# Scraper durable staging spool. Raw source images live in one Docker named
# volume shared by scraper API/workers/lifecycle; final assets still go to SeaweedFS/NAS.
SCRAPER_STAGING_VOLUME_NAME=mreader_scraper_staging
SCRAPER_STAGING_LEGACY_HOST_PATH=
SCRAPER_STAGING_REQUIRE_SHARED_MOUNT=true
SCRAPER_STAGING_LEGACY_REMOTE_FALLBACK=true
SCRAPER_STAGING_DELETE_LEGACY_AFTER_MIGRATE=true
SCRAPER_STAGING_TTL_HOURS=0
SCRAPER_STAGING_INCOMPLETE_TTL_MINUTES=60
SCRAPER_STAGING_CLEANUP_WAIT_SECONDS=30
SCRAPER_STAGING_RETENTION_SCAN_SECONDS=300
SCRAPER_STORAGE_ATTEMPT_HEARTBEAT_SECONDS=20
SCRAPER_STORAGE_ATTEMPT_STALE_SECONDS=300
SCRAPER_STORAGE_ATTEMPT_RECOVERY_BATCH=50
SCRAPER_STORAGE_ATTEMPT_RETENTION_DAYS=7
SCRAPER_STORAGE_NETWORK_MAX_ATTEMPTS=8
SCRAPER_STORAGE_NETWORK_RETRY_BASE_SECONDS=1.0
SCRAPER_STORAGE_NETWORK_RETRY_MAX_DELAY_SECONDS=15.0
SCRAPER_DB_POLL_MIN_INTERVAL_SECONDS=1.0
SCRAPER_PROGRESS_MIN_INTERVAL_SECONDS=2.0
# Optional full DSN for future managed/network PostgreSQL; blank keeps local Compose DB.
POSTGRES_URL=

# Durable lifecycle history retention (failed jobs are never auto-pruned)
LIFECYCLE_COMPLETED_RETENTION_DAYS=30
