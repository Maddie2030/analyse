# ── Database ──────────────────────────────────────
POSTGRES_USER=manhwa
POSTGRES_PASSWORD=manhwa
POSTGRES_DB=manhwa
DATABASE_URL=postgresql+asyncpg://manhwa:manhwa@db:5432/manhwa
DB_POOL_SIZE=4
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=10000

# ── Redis ──────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CACHE_REDIS_URL=redis://redis-cache:6380/0
REDIS_MAX_CONNECTIONS=40
REDIS_DATA_MAXMEMORY=384mb
REDIS_MAXMEMORY_POLICY=volatile-lru
REDIS_APPENDONLY=yes
REDIS_APPENDFSYNC=everysec

# ── SeaweedFS ──────────────────────────────────────
SEAWEEDFS_MASTER_URL=http://seaweedfs-master:9333
SEAWEEDFS_FILER_URL=http://seaweedfs-filer:8888
# Dedicated NAS / Docker Desktop hybrid: set the NAS LAN IP or stable hostname here.
# scripts/hybrid/deploy.sh derives the running Kubernetes SEAWEEDFS_FILER_URL
# from these two values, so changing .env requires a redeploy/sync before pods
# see the new endpoint.
NAS_SEAWEEDFS_HOST=192.168.1.50
NAS_SEAWEEDFS_PORT=8888
SEAWEEDFS_REPLICATION=001
SEAWEEDFS_HTTP_MAX_CONNECTIONS=16
SEAWEEDFS_HTTP_KEEPALIVE_CONNECTIONS=8
SEAWEEDFS_WRITE_CONCURRENCY=2
SEAWEEDFS_SLOW_WRITE_THRESHOLD_SECONDS=1.5
SEAWEEDFS_SLOW_WRITE_COOLDOWN_SECONDS=0.25
SEAWEEDFS_MAX_RETRIES=8
SEAWEEDFS_RETRY_BASE_SECONDS=1.0
SEAWEEDFS_RETRY_MAX_DELAY_SECONDS=15.0

# ── Docker Desktop hybrid profile ──────────────────
# Stateful Compose ports stay loopback-only when Docker Desktop Kubernetes can
# reach them through host.docker.internal. The deploy preflight verifies this.
# Only change the bind IP if your Docker Desktop networking requires it; if you
# expose these ports beyond loopback, protect them with Windows Firewall.
HYBRID_STATEFUL_BIND_IP=127.0.0.1
HYBRID_POSTGRES_PORT=5432
HYBRID_REDIS_PORT=6379
HYBRID_REDIS_CACHE_PORT=6380
HYBRID_RABBITMQ_AMQP_PORT=5672
HYBRID_RABBITMQ_MANAGEMENT_PORT=15672
# Hybrid deploy derives these namespace-safe KEDA endpoints automatically; do not
# normally set them by hand. They are documented here for diagnostics.
KEDA_RABBITMQ_HTTP_URL=
KEDA_POSTGRES_URL=
# Durable-volume ownership. Leave blank on first bootstrap: the one-time adoption
# helper selects canonical `mreader_*` names for fresh installs and prefers populated
# `mreader-hybrid-stateful_*` volumes during upgrades so historical state is not shadowed
# by newly initialized canonical volumes. Set MREADER_PREFER_LEGACY_STATEFUL_VOLUMES=false
# only when you deliberately want configured canonical volume names to remain authoritative.
HYBRID_PGDATA_VOLUME_NAME=
HYBRID_REDIS_VOLUME_NAME=
HYBRID_RABBITMQ_VOLUME_NAME=
HYBRID_IMAGE_CACHE_VOLUME_NAME=
# Upgrade continuity: prefer populated mreader-hybrid-stateful_* volumes over newly initialized canonical volumes.
MREADER_PREFER_LEGACY_STATEFUL_VOLUMES=true

# ── Auth / Sessions ────────────────────────────────
TOKEN_SECRET=change-me-in-production-use-a-long-random-string
CATALOG_INTERNAL_TOKEN=
MEDIA_INTERNAL_TOKEN=
RECOVERY_BRIDGE_TOKEN=
SESSION_TTL_SECONDS=86400
SESSION_COOKIE_NAME=session_id
COOKIE_SECURE=false

# ── Image Tokens ───────────────────────────────────
IMAGE_TOKEN_TTL_SECONDS=300
# Keep false for same-origin/local delivery. Gcore/hybrid Compose modes override true.
IMAGE_GRANT_ALLOW_SESSIONLESS_DELIVERY=false
PAGE_MAX_WIDTH=1080
PAGE_RESPONSIVE_WIDTH=720
PAGE_ENCODING_V4_ROWS=4
PAGE_ENCODING_V4_COLUMNS=4
PAGE_ENCODING_V4_OVERLAP=12

# ── Rate Limiting ──────────────────────────────────
RATE_LIMIT_REQUESTS=200
RATE_LIMIT_WINDOW_SECONDS=60

# ── Turnstile (optional) ───────────────────────────
TURNSTILE_SECRET=
TURNSTILE_ENABLED=false

# ── CORS / Frontend ────────────────────────────────
ALLOWED_ORIGIN=http://localhost,http://localhost:5173,http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080
DEBUG=false

# ── Upload ──────────────────────────────────────────
STORAGE_PATH=/data/manga_storage
MAX_UPLOAD_SIZE_MB=500
PAGE_MAX_SEGMENT_HEIGHT=8192
PAGE_WEBP_QUALITY=85
MAX_UNCOMPRESSED_PAGE_SIZE_MB=100
MAX_THUMBNAIL_SIZE_MB=10

# Catalog Go shadow safety gate. Keep false except during disposable write tests.
CATALOG_GO_ENABLE_WRITES=true

# Social TS notification retention
# Read alerts expire 14 days after delivery; unread alerts expire after 30 days.
NOTIFICATION_RETENTION_READ_DAYS=14
NOTIFICATION_RETENTION_UNREAD_DAYS=30
NOTIFICATION_RETENTION_SWEEP_HOURS=24
NOTIFICATION_RETENTION_BATCH_SIZE=5000
NOTIFICATION_RETENTION_MAX_BATCHES=20

# ── RabbitMQ / durable operational jobs + event dispatch ──
# Docker Desktop dev Compose starts RabbitMQ automatically. External RabbitMQ can be configured later by overriding RABBITMQ_URL.
RABBITMQ_USER=mreader
RABBITMQ_PASSWORD=mreader
RABBITMQ_VHOST=mreader
RABBITMQ_URL=amqp://mreader:mreader@rabbitmq:5672/mreader
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_JOBS_EXCHANGE=mreader.jobs
RABBITMQ_EVENTS_EXCHANGE=mreader.events
RABBITMQ_EVENTS_ARCHIVE_QUEUE=mreader.events.archive
RABBITMQ_RETRY_DELAY_MS=5000
RABBITMQ_MAX_ATTEMPTS=3

# Notification worker: durable at-least-once chapter/user notification delivery.
NOTIFICATION_WORKER_QUEUE=mreader.notification.worker
NOTIFICATION_RETRY_EXCHANGE=mreader.notification.retry
NOTIFICATION_RETRY_QUEUE=mreader.notification.worker.retry
NOTIFICATION_DEAD_EXCHANGE=mreader.notification.dead
NOTIFICATION_DEAD_QUEUE=mreader.notification.worker.dlq
NOTIFICATION_RETRY_DELAY_MS=5000
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_PREFETCH=8
NOTIFICATION_DB_MAX_CONNS=8

# Realtime Go: one same-origin WebSocket for alerts and discussion signals.
REALTIME_DB_MAX_CONNS=6
REALTIME_RECONNECT_DELAY_MS=2000
REALTIME_WRITE_TIMEOUT_SECONDS=10
REALTIME_PONG_WAIT_SECONDS=60
REALTIME_PING_PERIOD_SECONDS=25
REALTIME_SESSION_RECHECK_SECONDS=60
REALTIME_MAX_MESSAGE_BYTES=16384

# ── Backend resource efficiency ─────────────────────
# Defaults target a modest single-host deployment. Raise deliberately after
# observing CPU, RAM and PostgreSQL saturation; do not increase everything at once.
AUTH_API_WORKERS=1
IMAGE_API_WORKERS=1
SCRAPER_API_WORKERS=1
CATALOG_PY_API_WORKERS=1
READER_PY_API_WORKERS=1
SOCIAL_PY_API_WORKERS=1
MEDIA_WORKER_MAX_JOBS=2
MEDIA_RECOVERY_INTERVAL_SECONDS=30
MEDIA_PROCESSING_LEASE_SECONDS=120
MEDIA_HEARTBEAT_INTERVAL_SECONDS=30
VIPS_CONCURRENCY=1
VIPS_CACHE_MAX_OPS=100
VIPS_CACHE_MAX_MEM_MB=128
VIPS_CACHE_MAX_FILES=50
CATALOG_GO_DB_MAX_CONNS=10
READER_GO_DB_MAX_CONNS=14
PROGRESS_GO_DB_MAX_CONNS=6
SOCIAL_DB_CONNECTION_LIMIT=8
SOCIAL_DB_POOL_TIMEOUT=10
SCRAPER_REDIS_MAX_CONNECTIONS=32
SCRAPER_API_DB_MAX_CONNECTIONS=5
SCRAPER_API_HTTP_MAX_CONNECTIONS=32
SCRAPER_API_HTTP_KEEPALIVE_CONNECTIONS=12
SCRAPER_BATCH_DB_MAX_CONNECTIONS=3
SCRAPER_BATCH_HTTP_MAX_CONNECTIONS=16
SCRAPER_BATCH_HTTP_KEEPALIVE_CONNECTIONS=8
SCRAPER_SERIES_DB_MAX_CONNECTIONS=8
SCRAPER_SERIES_HTTP_MAX_CONNECTIONS=32
SCRAPER_SERIES_HTTP_KEEPALIVE_CONNECTIONS=16

# Scraper fetch escalation (HTTPX -> Scrapling curl_cffi -> Chromium when needed).
# Browser concurrency is intentionally independent from series-worker concurrency.
SCRAPER_SCRAPLING_ENABLED=true
SCRAPER_SCRAPLING_IMAGE_FALLBACK_ENABLED=true
SCRAPER_SCRAPLING_IMPERSONATE=chrome
SCRAPER_BROWSER_FALLBACK_ENABLED=false
SCRAPER_BROWSER_REMOTE_URL=
SCRAPER_BROWSER_CONCURRENCY=1
SCRAPER_BROWSER_TIMEOUT_MS=60000
SCRAPER_BROWSER_WAIT_MS=750
SCRAPER_BROWSER_AUTOSCROLL_STEPS=12
SCRAPER_BROWSER_SCROLL_DELAY_MS=250
SCRAPER_BROWSER_BLOCK_ADS=true
SCRAPER_BROWSER_CAPTURE_XHR_ENABLED=true
SCRAPER_BROWSER_CAPTURE_XHR_MAX_RESPONSES=16
SCRAPER_BROWSER_CAPTURE_XHR_MAX_BODY_BYTES=1048576
SCRAPER_ENGINE_AFFINITY_TTL_SECONDS=900
SCRAPER_ENGINE_AFFINITY_MAX_HOSTS=256
SCRAPER_IMAGE_DOWNLOAD_CONCURRENCY=6
# Keep false unless you have explicitly decided to use automated challenge solving.
SCRAPER_BROWSER_SOLVE_CLOUDFLARE=false

# ── Docker resource guardrails (upper bounds, not reservations) ─────
# Defaults protect a single host from runaway workers. Raise individual limits
# only after observing real pressure in Grafana/cAdvisor.
# Resource profile: v1.1.5c RC2 balanced = 50% of the temporary 2x profile.
MREADER_RESOURCE_PROFILE=v120-docker-balanced
DB_MEMORY_LIMIT=1g
DB_CPU_LIMIT=1.5
REDIS_MEMORY_LIMIT=640m
REDIS_CPU_LIMIT=0.75
# Hybrid twin-plane keeps this same aggregate Valkey budget split into critical/cache instances.
REDIS_CRITICAL_MEMORY_LIMIT=384m
REDIS_CRITICAL_CPU_LIMIT=0.45
REDIS_CRITICAL_DATA_MAXMEMORY=224mb
REDIS_CACHE_MEMORY_LIMIT=256m
REDIS_CACHE_CPU_LIMIT=0.30
REDIS_CACHE_DATA_MAXMEMORY=160mb
SEAWEED_MASTER_MEMORY_LIMIT=256m
SEAWEED_MASTER_CPU_LIMIT=0.5
SEAWEED_VOLUME_MEMORY_LIMIT=1g
SEAWEED_VOLUME_CPU_LIMIT=1.0
SEAWEED_FILER_MEMORY_LIMIT=512m
SEAWEED_FILER_CPU_LIMIT=0.75
AUTH_MEMORY_LIMIT=384m
AUTH_CPU_LIMIT=0.5
CATALOG_MEMORY_LIMIT=256m
CATALOG_CPU_LIMIT=0.75
READER_MEMORY_LIMIT=384m
READER_CPU_LIMIT=1.0
PROGRESS_MEMORY_LIMIT=256m
PROGRESS_CPU_LIMIT=0.5
SOCIAL_MEMORY_LIMIT=512m
SOCIAL_CPU_LIMIT=1.0
SOCIAL_NODE_MAX_OLD_SPACE_MB=320
SCRAPER_API_MEMORY_LIMIT=512m
SCRAPER_API_CPU_LIMIT=1.0
SCRAPER_BATCH_MEMORY_LIMIT=768m
SCRAPER_BATCH_CPU_LIMIT=1.0
SCRAPER_SERIES_MEMORY_LIMIT=1g
SCRAPER_SERIES_CPU_LIMIT=1.5
IMAGE_API_MEMORY_LIMIT=640m
IMAGE_API_CPU_LIMIT=1.0
MEDIA_WORKER_MEMORY_LIMIT=2g
MEDIA_WORKER_CPU_LIMIT=2.0
LIFECYCLE_MEMORY_LIMIT=384m
LIFECYCLE_CPU_LIMIT=0.5
IMAGE_EDGE_MEMORY_LIMIT=256m
IMAGE_EDGE_CPU_LIMIT=0.5
FRONTEND_MEMORY_LIMIT=192m
FRONTEND_CPU_LIMIT=0.25
GATEWAY_MEMORY_LIMIT=256m
GATEWAY_CPU_LIMIT=0.5
RABBITMQ_MEMORY_LIMIT=512m
RABBITMQ_CPU_LIMIT=0.75
NOTIFICATION_WORKER_MEMORY_LIMIT=256m
NOTIFICATION_WORKER_CPU_LIMIT=0.5
REALTIME_MEMORY_LIMIT=256m
REALTIME_CPU_LIMIT=0.5
MEDIA_THUMBNAIL_WORKER_MEMORY_LIMIT=512m
MEDIA_THUMBNAIL_WORKER_CPU_LIMIT=1.0
MEDIA_THUMBNAIL_WORKER_MAX_JOBS=2
PROMETHEUS_MEMORY_LIMIT=768m
PROMETHEUS_CPU_LIMIT=1.0
GRAFANA_MEMORY_LIMIT=512m
GRAFANA_CPU_LIMIT=0.75
LOKI_MEMORY_LIMIT=512m
LOKI_CPU_LIMIT=0.75
ALLOY_MEMORY_LIMIT=384m
ALLOY_CPU_LIMIT=0.5
CADVISOR_MEMORY_LIMIT=256m
CADVISOR_CPU_LIMIT=0.5
BLACKBOX_MEMORY_LIMIT=128m
BLACKBOX_CPU_LIMIT=0.25
UPTIME_KUMA_MEMORY_LIMIT=384m
UPTIME_KUMA_CPU_LIMIT=0.5
CROWDSEC_MEMORY_LIMIT=384m
CROWDSEC_CPU_LIMIT=0.5
CLOUDFLARED_MEMORY_LIMIT=128m
CLOUDFLARED_CPU_LIMIT=0.25
NGROK_MEMORY_LIMIT=192m
NGROK_CPU_LIMIT=0.25
MIGRATE_MEMORY_LIMIT=256m
MIGRATE_CPU_LIMIT=0.5

# ── Durable workers / lifecycle ────────────────────
SCRAPER_SERIES_WORKER_CONCURRENCY=4
LIFECYCLE_CLEANUP_POLL_SECONDS=2
LIFECYCLE_HEARTBEAT_SECONDS=30
LIFECYCLE_PROCESSING_STALE_SECONDS=300
LIFECYCLE_RECOVERY_INTERVAL_SECONDS=60

# ── Reader runtime / CDN ───────────────────────────
# Empty = same-origin /images through the local authenticated image-edge cache.
# Set to a Gcore/other CDN hostname only when that CDN fronts the scrambled /images assets.
IMAGE_CDN_URL=
READER_FETCH_BEHIND=1
READER_FETCH_AHEAD=2
READER_RETAIN_BEHIND=2
READER_RETAIN_AHEAD=4

# Optional external edge/tunnel modes
# Hybrid dual-public-edge profile: the Kubernetes gateway remains on Docker Desktop's
# local LoadBalancer, while both public adapters target the same local gateway.
CADDY_SITE_ADDRESS=:80
HYBRID_GATEWAY_PORT=8080
# RC4.36 admin/ingestion plane is intentionally not attached to public tunnels.
HYBRID_ADMIN_GATEWAY_PORT=8081
LOCAL_GATEWAY_PORT=8080
# both | tailscale | cloudflare | none. This package defaults to both.
HYBRID_PUBLIC_EDGES=both
# If true, ./hybrid-up.sh fails when no requested public edge is available.
# Keep false for resilient development: local hybrid deployment still succeeds.
HYBRID_PUBLIC_REQUIRED=false
# Filled automatically by scripts/hybrid/public-up.sh.
TAILSCALE_PUBLIC_URL=
TAILSCALE_FUNNEL_HTTPS_PORT=443
CLOUDFLARE_QUICK_PUBLIC_URL=
PUBLIC_ALLOWED_ORIGINS=
PUBLIC_BASE_URLS=
# Quick Tunnel requires no account/token. HTTP/2 is more reliable through Docker Desktop
# than depending on UDP/QUIC, and the container is capped by CLOUDFLARED_* above.
CLOUDFLARED_PROTOCOL=http2
CLOUDFLARE_QUICK_STARTUP_TIMEOUT_SECONDS=120
CLOUDFLARE_QUICK_PUBLIC_PROBE_SECONDS=90
# Named Cloudflare Tunnel remains optional for other deployment modes.
CLOUDFLARE_TUNNEL_TOKEN=
# Optional lifecycle cache purge credentials. Leave blank to disable provider API purges.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
GCORE_CDN_URL=
GCORE_CDN_RESOURCE_ID=
GCORE_API_TOKEN=
GCORE_ORIGIN_PORT=8088
NGROK_AUTHTOKEN=
NGROK_DOMAIN=


# ── v1.1.4 reader analytics / progress recovery ─────
# Trending is non-critical: failures must never fail a Reader request.
READER_TRENDING_ENABLED=true
READER_TRENDING_DEDUPE_TTL_SECONDS=1800
READER_TRENDING_QUEUE_SIZE=4096
READER_TRENDING_WORKERS=2
READER_TRENDING_RETENTION_DAYS=45

# Recover Progress stream messages abandoned by a crashed worker.
PROGRESS_GO_RECLAIM_MIN_IDLE_SECONDS=30
PROGRESS_GO_RECLAIM_INTERVAL_SECONDS=10

# ── Transactional outbox relay ──────────────────────
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_CLAIM_STALE_SECONDS=120
OUTBOX_PUBLISH_TIMEOUT_SECONDS=10
OUTBOX_RETRY_BASE_SECONDS=1
OUTBOX_RETRY_MAX_SECONDS=300
OUTBOX_DB_MAX_CONNS=10
OUTBOX_RELAY_MEMORY_LIMIT=256m
OUTBOX_RELAY_CPU_LIMIT=0.5

# ── Observability ──────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-sharing-the-host
GCORE_ORIGIN_BIND=0.0.0.0

# Durable scraper cancellation/recovery convergence
SCRAPER_RECOVERY_INTERVAL_SECONDS=15

# Scraper durable staging spool. Raw source images live in one Docker named
# volume shared by scraper API/workers/lifecycle; final assets still go to SeaweedFS/NAS.
# The explicit volume name keeps staging stable across versioned ZIP folders.
SCRAPER_STAGING_VOLUME_NAME=mreader_scraper_staging
# Optional one-time migration source for RC4.7-RC4.11 bind-mounted staging.
# Leave blank unless automatic discovery cannot find the old spool.
SCRAPER_STAGING_LEGACY_HOST_PATH=
SCRAPER_STAGING_REQUIRE_SHARED_MOUNT=true
SCRAPER_STAGING_LEGACY_REMOTE_FALLBACK=false
SCRAPER_STAGING_DELETE_LEGACY_AFTER_MIGRATE=false
SCRAPER_STAGING_TTL_HOURS=0
SCRAPER_STAGING_INCOMPLETE_TTL_MINUTES=60
SCRAPER_STAGING_CLEANUP_WAIT_SECONDS=30
SCRAPER_STAGING_RETENTION_SCAN_SECONDS=300
SCRAPER_STORAGE_ATTEMPT_HEARTBEAT_SECONDS=20
SCRAPER_STORAGE_ATTEMPT_STALE_SECONDS=300
SCRAPER_STORAGE_ATTEMPT_RECOVERY_BATCH=50
SCRAPER_STORAGE_ATTEMPT_RETENTION_DAYS=7
SCRAPER_STORAGE_NETWORK_MAX_ATTEMPTS=8
SCRAPER_STORAGE_NETWORK_RETRY_BASE_SECONDS=1.0
SCRAPER_STORAGE_NETWORK_RETRY_MAX_DELAY_SECONDS=15.0
SCRAPER_DB_POLL_MIN_INTERVAL_SECONDS=1.0
SCRAPER_PROGRESS_MIN_INTERVAL_SECONDS=2.0
# Optional full DSN for future managed/network PostgreSQL; blank keeps local Compose DB.
POSTGRES_URL=

# Durable lifecycle history retention (failed jobs are never auto-pruned)
LIFECYCLE_COMPLETED_RETENTION_DAYS=30
LIFECYCLE_PRUNE_INTERVAL_SECONDS=3600

# PostgreSQL backup protection (Docker Desktop hybrid)
# Logical backup: first successful system/backup-agent run each local calendar day.
# A verified manual/admin logical backup satisfies that day, so the automatic dump is skipped.
# Automatic logical backup: at most once per local calendar day, only while the system is online between 20:00 and 22:00.
# A verified manual admin backup taken earlier that day suppresses the automatic logical backup.
# Physical snapshot: every N days, also limited to the same maintenance window unless invoked manually.
# Host recovery-root contract. Startup persists an absolute literal path here.
# Default: Linux host home/.mreader/database-protection; Windows/Git Bash C:/mreader/database-protection.
# An existing value is preserved. Do not use $HOME, ~ or shell substitutions.
# Configuration preparation only: storage migration is a separate upgrade step.
MREADER_DB_PROTECTION_ROOT=
# Initialization/testing only. Keep false for normal upgrades so migrations remain protected by a verified pre-upgrade bundle.
MREADER_SKIP_PREUPGRADE_BACKUP=false
POSTGRES_BACKUP_ENABLED=true
POSTGRES_BACKUP_REPLICATION_USER=mreader_backup
# Optional. Empty means reuse POSTGRES_PASSWORD for the dedicated replication role.
POSTGRES_BACKUP_REPLICATION_PASSWORD=
POSTGRES_BACKUP_DAILY_RETENTION_DAYS=4
POSTGRES_BACKUP_SNAPSHOT_EVERY_DAYS=2
POSTGRES_BACKUP_SNAPSHOT_RETENTION_DAYS=2
POSTGRES_BACKUP_TZ=Asia/Kolkata
POSTGRES_BACKUP_AUTO_WINDOW_START=20:00
POSTGRES_BACKUP_AUTO_WINDOW_END=22:00
POSTGRES_BACKUP_MEMORY_LIMIT=256m
POSTGRES_BACKUP_CPU_LIMIT=0.5
POSTGRES_BACKUP_SNAPSHOT_MAX_RATE=32M
POSTGRES_BACKUP_VERIFY_TIME=21:00

HYBRID_RECOVERY_BRIDGE_PORT=18084

# P09.3 generated workload database identities (filled by scripts/hybrid/reconcile-postgres-roles.sh)
MREADER_DB_ROLE_PASSWORD_MREADER_AUTH_ADMIN=
MREADER_DB_DSN_MREADER_AUTH_ADMIN=
MREADER_DB_ROLE_PASSWORD_MREADER_AUTH_SERVICE=
MREADER_DB_DSN_MREADER_AUTH_SERVICE=
MREADER_DB_ROLE_PASSWORD_MREADER_CATALOG_ADMIN=
MREADER_DB_DSN_MREADER_CATALOG_ADMIN=
MREADER_DB_ROLE_PASSWORD_MREADER_CATALOG_GO=
MREADER_DB_DSN_MREADER_CATALOG_GO=
MREADER_DB_ROLE_PASSWORD_MREADER_IMAGE_SERVICE=
MREADER_DB_DSN_MREADER_IMAGE_SERVICE=
MREADER_DB_ROLE_PASSWORD_MREADER_KEDA_METRICS=
MREADER_DB_DSN_MREADER_KEDA_METRICS=
MREADER_DB_ROLE_PASSWORD_MREADER_LIFECYCLE_WORKER=
MREADER_DB_DSN_MREADER_LIFECYCLE_WORKER=
MREADER_DB_ROLE_PASSWORD_MREADER_MEDIA_THUMBNAIL_WORKER=
MREADER_DB_DSN_MREADER_MEDIA_THUMBNAIL_WORKER=
MREADER_DB_ROLE_PASSWORD_MREADER_MEDIA_WORKER=
MREADER_DB_DSN_MREADER_MEDIA_WORKER=
MREADER_DB_ROLE_PASSWORD_MREADER_NOTIFICATION_WORKER=
MREADER_DB_DSN_MREADER_NOTIFICATION_WORKER=
MREADER_DB_ROLE_PASSWORD_MREADER_OUTBOX_RELAY=
MREADER_DB_DSN_MREADER_OUTBOX_RELAY=
MREADER_DB_ROLE_PASSWORD_MREADER_PROGRESS_GO=
MREADER_DB_DSN_MREADER_PROGRESS_GO=
MREADER_DB_ROLE_PASSWORD_MREADER_READER_GO=
MREADER_DB_DSN_MREADER_READER_GO=
MREADER_DB_ROLE_PASSWORD_MREADER_REALTIME_GO=
MREADER_DB_DSN_MREADER_REALTIME_GO=
MREADER_DB_ROLE_PASSWORD_MREADER_SCRAPER_BATCH_WORKER=
MREADER_DB_DSN_MREADER_SCRAPER_BATCH_WORKER=
MREADER_DB_ROLE_PASSWORD_MREADER_SCRAPER_SERIES_WORKER=
MREADER_DB_DSN_MREADER_SCRAPER_SERIES_WORKER=
MREADER_DB_ROLE_PASSWORD_MREADER_SCRAPER_SERVICE=
MREADER_DB_DSN_MREADER_SCRAPER_SERVICE=
MREADER_DB_ROLE_PASSWORD_MREADER_SOCIAL_TS=
MREADER_DB_DSN_MREADER_SOCIAL_TS=
