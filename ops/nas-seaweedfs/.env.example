# MReader NAS SeaweedFS storage contract.
# These defaults intentionally match the established MReader NAS layout.
# Existing installations should keep their current data paths; do not move data
# merely to match a release package. The verification scripts inspect the
# running SeaweedFS volume container and publish its actual /data bind source.

NAS_BIND_IP=0.0.0.0
NAS_SEAWEEDFS_PORT=8888

# Dedicated filesystem mount roots (informational + safety checks).
NAS_HDD_ROOT=/srv/seaweed/hdd
NAS_SSD_ROOT=/srv/seaweed/ssd/meta

# Exact host directories bound into the SeaweedFS containers.
# This is the authoritative physical backup/media chunk location.
NAS_VOLUME_DATA_DIR=/srv/seaweed/hdd/volumes
NAS_MASTER_DATA_DIR=/srv/seaweed/ssd/meta/master
NAS_FILER_DATA_DIR=/srv/seaweed/ssd/meta/filer

# For package-managed NAS installs, the Windows MReader expected root should match NAS_VOLUME_DATA_DIR:
# POSTGRES_BACKUP_EXPECTED_PHYSICAL_ROOT=/srv/seaweed/hdd/volumes

SEAWEEDFS_VOLUME_SIZE_LIMIT_MB=2048
SEAWEED_MASTER_MEMORY_LIMIT=256m
SEAWEED_MASTER_CPU_LIMIT=0.35
SEAWEED_FILER_MEMORY_LIMIT=512m
SEAWEED_FILER_CPU_LIMIT=0.6
SEAWEED_VOLUME_MEMORY_LIMIT=1g
SEAWEED_VOLUME_CPU_LIMIT=1.0

# Logical Filer root used for PostgreSQL backup objects and storage proof.
# MUST exactly match POSTGRES_BACKUP_NAS_PATH in the Windows MReader .env.
POSTGRES_BACKUP_NAS_PATH=backups/mreader/postgres
